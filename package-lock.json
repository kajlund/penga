{
  "name": "penga",
  "version": "0.1.0",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "penga",
      "version": "0.1.0",
      "workspaces": [
        "apps/*",
        "packages/*"
      ],
      "devDependencies": {
        "typescript": "^5.8.2"
      }
    },
    "apps/api": {
      "name": "@penga/api",
      "version": "0.1.0",
      "dependencies": {
        "@penga/shared": "*"
      }
    },
    "apps/web": {
      "name": "@penga/web",
      "version": "0.1.0",
      "dependencies": {
        "@penga/shared": "*"
      }
    },
    "node_modules/@penga/api": {
      "resolved": "apps/api",
      "link": true
    },
    "node_modules/@penga/shared": {
      "resolved": "packages/shared",
      "link": true
    },
    "node_modules/@penga/web": {
      "resolved": "apps/web",
      "link": true
    },
    "node_modules/typescript": {
      "version": "5.9.3",
      "resolved": "https://registry.npmjs.org/typescript/-/typescript-5.9.3.tgz",
      "integrity": "sha512-jl1vZzPDinLr9eUt3J/t7V6FgNEw9QjvBPdysz9KfQDD41fQrC2Y4vKQdiaUpFT4bXlb1RHhLpp8wtm6M5TgSw==",
      "dev": true,
      "license": "Apache-2.0",
      "bin": {
        "tsc": "bin/tsc",
        "tsserver": "bin/tsserver"
      },
      "engines": {
        "node": ">=14.17"
      }
    },
    "packages/shared": {
      "name": "@penga/shared",
      "version": "0.1.0"
    }
  }
}
